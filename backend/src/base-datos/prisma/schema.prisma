generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Marca {
  id       String    @id @default(uuid())
  nombre   String    @unique
  historia String?   @db.Text
  perfumes Perfume[]

  @@map("marcas")
}

model Perfume {
  id              String   @id @default(uuid())
  nombre          String
  marcaId         String
  marca           Marca    @relation(fields: [marcaId], references: [id])
  clasificacion   String   // "Arabe" | "Nicho" | "Diseñador"
  genero          String   // "Masculino" | "Femenino" | "Unisex"
  concentracion   String   // "EDP" | "EDT" | "Parfum" | "EDC"
  volumenMl       Int
  familiaOlfativa String   // "Floral" | "Oriental" | "Amaderado" | "Fresco" | "Citrico"
  descripcion     String?  @db.Text
  imagenUrl       String?

  precioProveedorCrc Float   // Costo real del proveedor (OCULTO al público)
  precioVentaCrc     Float   // Precio público de venta
  margenGanancia     Float   // precioVentaCrc - precioProveedorCrc

  stockProveedor Boolean @default(true)
  pedidos        Pedido[]

  @@map("perfumes")
}

model Pedido {
  id                   String   @id @default(uuid())
  fechaPedido          DateTime @default(now())
  clienteNombre        String
  clienteWhatsapp      String
  clienteDireccion     String   @db.Text
  perfumeId            String
  perfume              Perfume  @relation(fields: [perfumeId], references: [id])
  totalCobradoCrc      Float
  montoAPagarProveedor Float
  gananciaNetaRetenida Float

  estadoPagoSinpe  String @default("PENDIENTE")  // "PENDIENTE" | "CONFIRMADO"
  estadoDespacho   String @default("NO_ENVIADO")  // "NO_ENVIADO" | "ENVIADO" | "ENTREGADO"

  @@map("pedidos")
}
